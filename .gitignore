# Dataset and derived artifacts.
# Leading slash is required: a bare "data/" would also match src/ecg/data/,
# silently excluding the data-loading package from the repo.
/data/
*.zip

# Experiment outputs
mlruns/
mlartifacts/
outputs/
checkpoints/
*.ckpt
*.pt

# Tracking databases pulled off Drive to read locally, plus the sidecars
# SQLite and sync_tracking leave beside them. Tens of MB of binary that the
# study already keeps durably; the repo is not its home.
*.db
*.db.tmp
*.db-wal
*.db-shm

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Notebooks
.ipynb_checkpoints/

# Environments / editors
.venv/
.env
.vscode/
.idea/
